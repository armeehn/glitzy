# etsch.hq.ripostelabs.xyz -> Etsch, served straight off this box.
#
# Etsch is a static, server-less app (it also deploys to Cloudflare as the
# public glitzy.ripostelabs.xyz), so there is no container and no upstream to
# proxy: the tree lives in /var/www/etsch here and Caddy is the whole server.
# Update it with studio/deploy-etsch.sh from the repo, run on x.
#
# Until 2026-08-13 it was not deployed anywhere at all, while the studio's
# header linked to cutsheet.armeehn.workers.dev -- the tool's old name, on a
# host that has never resolved. Sheets built by the studio were fine; there
# was simply nowhere to open them.
#
# /handoff/<id> is the one dynamic route. Glitzy's "Open in Etsch"
# stores the finished sheet as a file on its own engine and sends the browser
# here with #handoff=<that file id>; this path is how Etsch reads it back.
# It is proxied onto THIS origin rather than fetched from glitzy.hq
# because Etsch ships `connect-src 'self'` -- a cross-origin fetch would be
# refused by the browser, and widening that CSP for one feature is a worse
# trade than proxying one path. The id shape is checked on both sides
# (16 lowercase hex); anything else never leaves the browser.
# cutsheet.hq is the tool's pre-rename name, kept answering on purpose so no
# bookmark or shared link breaks. Both names serve the same tree; neither is a
# redirect, because a redirect would strip the #handoff= fragment the studio
# sends -- fragments are not sent to the server, so Caddy cannot put one back.
@etsch host etsch.hq.ripostelabs.xyz cutsheet.hq.ripostelabs.xyz
handle @etsch {
	import authelia

	handle_path /handoff/* {
		rewrite * /api/file{uri}
		reverse_proxy 10.0.1.178:8090
	}

	handle {
		# Mirrors etsch/public/_headers, which Cloudflare reads and Caddy does
		# not. Keep the two in step: the CSP is what makes "Open project"
		# decode its own data: URLs instead of fetching them, and a test
		# asserts connect-src is still 'self' so that stays true.
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
			Cross-Origin-Opener-Policy same-origin
			-Server
		}
		root * /var/www/etsch
		# Unknown paths fall back to the single page, matching wrangler.toml's
		# not_found_handling = "single-page-application".
		try_files {path} /index.html
		file_server
	}
}
