[Unit]
Description=Glitzy engine v2 (chain studio)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/glitzy
ExecStart=/usr/bin/python3 -m glitzyd.server
Environment=PYTHONUNBUFFERED=1
Environment=GLITZY_DATA=/var/lib/glitzy
Environment=GLITZY_WEB=/opt/glitzy/web
Environment=GLITZY_RACK=/opt/glitzy/rack
Environment=GLITZY_PORT=8090
Environment=GLITZY_FFGAC=/opt/ffglitch/bin/ffgac
Environment=GLITZY_FFEDIT=/opt/ffglitch/bin/ffedit
# Where "Open in Etsch" hands the sheet. The studio hides the button and the
# header link when this is empty rather than guessing a URL -- the old
# hard-coded etsch.armeehn.workers.dev never existed, so the link looked
# live and went nowhere. Etsch is served by Caddy on LXC 104 from
# /var/www/etsch; the /handoff/ path there proxies back to this engine.
Environment=GLITZY_ETSCH=https://etsch.hq.ripostelabs.xyz
Restart=on-failure
RestartSec=2
# The host is RAM-oversubscribed and the container has 2 GB. numpy frame stacks
# are the whole memory story here, so cap the engine rather than let a 240-frame
# chain at 1600 px take the container down.
MemoryMax=1400M
Nice=5

[Install]
WantedBy=multi-user.target
